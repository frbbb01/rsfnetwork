{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/database",
      "destination": "/database"
    },
    {
      "source": "/community",
      "destination": "/community"
    },
    {
      "source": "/arcade",
      "destination": "/arcade"
    },
    {
      "source": "/rsf",
      "destination": "/rsf"
    },
    {
      "source": "/privacy",
      "destination": "/privacy"
    },
    {
      "source": "/terms",
      "destination": "/terms"
    },
    {
      "source": "/callback",
      "destination": "/api/callback"
    },
    {
      "source": "/profile/:username",
      "destination": "/profile"
    }
  ]
}
